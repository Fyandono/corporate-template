---
import { getCollection } from 'astro:content';
import BusinessCard from '../../components/sections/BusinessCard.tsx';
import CinematicStatement from '../../components/sections/CinematicStatement.tsx';
import CtaBand from '../../components/sections/CtaBand.tsx';
import Hero from '../../components/sections/Hero.tsx';
import NewsCard from '../../components/sections/NewsCard.tsx';
import StatsBand from '../../components/sections/StatsBand.tsx';
import Button from '../../components/ui/Button.tsx';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.tsx';
import { site } from '../../config/site';
import { getLangPaths, getLocale, localize, localizedPath, t } from '../../i18n';
import { businessCardProps, newsCardProps } from '../../lib/cards';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const home = dict.home;

const business = (await getCollection('business')).sort((a, b) => a.data.order - b.data.order);
const news = site.features.news
  ? (await getCollection('news', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      .slice(0, 3)
  : [];
const businessHref = (id: string) =>
  site.features.businessDetailPages ? localizedPath(lang, `/business/${id}`) : undefined;
const businessCards = await Promise.all(
  business.map((entry, i) => businessCardProps(entry, lang, i, businessHref(entry.id))),
);
const newsCards = await Promise.all(
  news.map((entry) =>
    newsCardProps(entry, lang, localizedPath(lang, `/news/${entry.id.split('/')[1]}`)),
  ),
);
const stats = site.stats.map((stat) => ({
  value: stat.value,
  label: localize(stat.label, lang),
  suffix: stat.suffix && localize(stat.suffix, lang),
}));
---

<BaseLayout lang={lang}>
  <Hero
    eyebrow={home.heroEyebrow}
    title={home.heroTitle}
    lead={home.heroLead}
    primary={{ label: home.heroPrimary, href: localizedPath(lang, '/about') }}
    secondary={{ label: home.heroSecondary, href: localizedPath(lang, '/business') }}
    meta={[`${home.heroEstablished} ${site.foundingYear}`, home.heroLocation]}
    scrollLabel={dict.common.scrollDown}
  />

  <section aria-labelledby="intro-title">
    <Container class="grid gap-12 pt-28 pb-20 md:pt-40 md:pb-28 lg:grid-cols-12">
      <SectionHeading
        id="intro-title"
        index="01"
        eyebrow={home.introEyebrow}
        title={home.introTitle}
        className="lg:col-span-7"
      />
      <div class="lg:col-span-4 lg:col-start-9 lg:pt-16" data-reveal>
        <p class="text-lead text-neutral-600">{home.introBody}</p>
        <Button href={localizedPath(lang, '/about')} variant="secondary" className="mt-10">
          {dict.common.learnMore}
        </Button>
      </div>
    </Container>
  </section>

  <StatsBand title={home.statsTitle} note={home.statsNote} stats={stats} locale={lang} />

  <section aria-labelledby="business-title" class="bg-neutral-50">
    <Container class="py-28 md:py-40">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          id="business-title"
          index="02"
          eyebrow={home.businessEyebrow}
          title={home.businessTitle}
        />
        <Button href={localizedPath(lang, '/business')} variant="secondary" className="shrink-0">
          {dict.common.learnMore}
        </Button>
      </div>
      <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {businessCards.map((card) => (
          <BusinessCard {...card} />
        ))}
      </div>
    </Container>
  </section>

  <CinematicStatement index="03" eyebrow={home.statementEyebrow} statement={home.statement} />

  {newsCards.length > 0 && (
    <section aria-labelledby="news-title">
      <Container class="py-28 md:py-40">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <SectionHeading
            id="news-title"
            index="04"
            eyebrow={home.newsEyebrow}
            title={home.newsTitle}
          />
          <Button href={localizedPath(lang, '/news')} variant="secondary" className="shrink-0">
            {dict.common.learnMore}
          </Button>
        </div>
        <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {newsCards.map((card) => (
            <NewsCard {...card} />
          ))}
        </div>
      </Container>
    </section>
  )}

  <CtaBand
    title={home.ctaTitle}
    body={home.ctaBody}
    action={{ label: home.ctaButton, href: localizedPath(lang, '/contact') }}
  />
</BaseLayout>
