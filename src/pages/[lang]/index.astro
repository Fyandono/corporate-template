---
import AboutIntro from '../../components/sections/AboutIntro.tsx';
import BusinessSection from '../../components/sections/BusinessSection.tsx';
import CtaBand from '../../components/sections/CtaBand.tsx';
import Hero from '../../components/sections/Hero.tsx';
import NewsSection from '../../components/sections/NewsSection.tsx';
import StatsBand from '../../components/sections/StatsBand.tsx';
import VisionMission from '../../components/sections/VisionMission.tsx';
import { site } from '../../config/site';
import { getLangPaths, getLocale, localizedPath, t } from '../../i18n';
import { loadHomeIntro, loadStats, loadVisionMission } from '../../lib/sections/about';
import { loadHomeBusiness } from '../../lib/sections/business';
import { loadHero } from '../../lib/sections/hero';
import { loadHomeNews } from '../../lib/sections/news';
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Beranda — hanya komposisi. Data tiap section disiapkan di src/lib/sections/.
 * Nomor section ("01", "02", …) mengikuti urutan tampil; berita mengikuti `site.features.news`.
 */
export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const { home } = t(lang);

const [hero, stats, business, visionMission, news] = await Promise.all([
  loadHero(lang),
  loadStats(lang),
  loadHomeBusiness(lang),
  loadVisionMission(lang),
  site.features.news ? loadHomeNews(lang) : undefined,
]);
const showNews = news && news.cards.length > 0;
---

<BaseLayout lang={lang}>
  <Hero {...hero} />

  <AboutIntro id="intro" index="01" {...loadHomeIntro(lang)} />
  <StatsBand {...stats} />

  <BusinessSection id="business" index="02" {...business} />

  <VisionMission id="vision" index="03" {...visionMission} />

  {showNews && <NewsSection id="news" index="04" {...news} />}

  <CtaBand
    title={home.ctaTitle}
    body={home.ctaBody}
    action={{ label: home.ctaButton, href: localizedPath(lang, '/contact') }}
  />
</BaseLayout>
