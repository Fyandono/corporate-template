---
import { getCollection } from 'astro:content';
import NewsCard from '../../../components/sections/NewsCard.tsx';
import PageHero from '../../../components/sections/PageHero.tsx';
import Container from '../../../components/ui/Container.astro';
import { site } from '../../../config/site';
import { getLangPaths, getLocale, localizedPath, t } from '../../../i18n';
import { newsCardProps } from '../../../lib/cards';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Modul opsional: site.features.news
export const getStaticPaths = () => (site.features.news ? getLangPaths() : []);
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const page = dict.news;

const news = (
  await getCollection('news', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const cards = await Promise.all(
  news.map((entry) =>
    newsCardProps(entry, lang, localizedPath(lang, `/news/${entry.id.split('/')[1]}`)),
  ),
);
const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: page.title, path: localizedPath(lang, '/news') },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} breadcrumbs={breadcrumbs}>
  <PageHero
    title={page.title}
    lead={page.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <Container class="py-20 md:py-28">
    {cards.length === 0 ? (
      <p class="text-neutral-600">{page.empty}</p>
    ) : (
      <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {cards.map((card) => (
          <NewsCard {...card} />
        ))}
      </div>
    )}
  </Container>
</BaseLayout>
