---
import NewsSection from '../../../components/sections/NewsSection.tsx';
import PageHero from '../../../components/sections/PageHero.tsx';
import { site } from '../../../config/site';
import { getLangPaths, getLocale, localizedPath, t } from '../../../i18n';
import { loadNews } from '../../../lib/sections/news';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Modul opsional: site.features.news
export const getStaticPaths = () => (site.features.news ? getLangPaths() : []);
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const page = dict.news;
const section = await loadNews(lang);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: page.title, path: localizedPath(lang, '/news') },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} breadcrumbs={breadcrumbs}>
  <PageHero
    title={page.title}
    lead={page.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <NewsSection {...section} />
</BaseLayout>
