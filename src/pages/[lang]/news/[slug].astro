---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHero from '../../../components/sections/PageHero.tsx';
import Container from '../../../components/ui/Container.astro';
import { site } from '../../../config/site';
import { formatDate, getLocale, locales, localizedPath, t, type Locale } from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Modul opsional: site.features.news
export async function getStaticPaths() {
  if (!site.features.news) return [];
  const entries = await getCollection('news', (e) => !e.data.draft);
  const pathOf = (e: CollectionEntry<'news'>) => {
    const [lang, slug] = e.id.split('/') as [Locale, string];
    return localizedPath(lang, `/news/${slug}`);
  };

  return entries.map((entry) => {
    const [lang, slug] = entry.id.split('/') as [Locale, string];
    // Padanan bahasa lain via translationKey; jika belum ada terjemahan, arahkan ke daftar berita.
    const alternates = Object.fromEntries(
      locales.map((l) => {
        const match = entries.find(
          (e) => e.id.startsWith(`${l}/`) && e.data.translationKey === entry.data.translationKey,
        );
        return [l, match ? pathOf(match) : localizedPath(l, '/news')];
      }),
    ) as Record<Locale, string>;
    return { params: { lang, slug }, props: { entry, alternates } };
  });
}

type Props = { entry: CollectionEntry<'news'>; alternates: Record<Locale, string> };
const { entry, alternates } = Astro.props;
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const { Content } = await render(entry);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: dict.news.title, path: localizedPath(lang, '/news') },
  { name: entry.data.title, path: alternates[lang] },
];
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
  image={entry.data.cover.src}
  type="article"
  article={{ publishedTime: entry.data.date }}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title={entry.data.title}
    lead={entry.data.description}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <Container class="py-16 md:py-24">
    <article class="mx-auto max-w-3xl">
      <time datetime={entry.data.date.toISOString()} class="text-small text-neutral-500">
        {formatDate(entry.data.date, lang)}
      </time>
      <Image
        src={entry.data.cover}
        alt={entry.data.coverAlt}
        widths={[768, 1536]}
        sizes="(min-width: 768px) 768px, 100vw"
        class="rounded-card mt-6 w-full"
      />
      <div class="prose-content mt-10">
        <Content />
      </div>
      <a
        href={localizedPath(lang, '/news')}
        class="text-primary-700 mt-12 inline-block font-semibold hover:underline"
      >
        &larr; {dict.news.backToList}
      </a>
    </article>
  </Container>
</BaseLayout>
