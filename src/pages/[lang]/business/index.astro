---
import { getCollection } from 'astro:content';
import BusinessCard from '../../../components/sections/BusinessCard.tsx';
import PageHero from '../../../components/sections/PageHero.tsx';
import Container from '../../../components/ui/Container.astro';
import { site } from '../../../config/site';
import { getLangPaths, getLocale, localizedPath, t } from '../../../i18n';
import { businessCardProps } from '../../../lib/cards';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const page = dict.business;

const business = (await getCollection('business')).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(
  business.map((entry, i) =>
    businessCardProps(
      entry,
      lang,
      i,
      site.features.businessDetailPages ? localizedPath(lang, `/business/${entry.id}`) : undefined,
    ),
  ),
);
const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: page.title, path: localizedPath(lang, '/business') },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} breadcrumbs={breadcrumbs}>
  <PageHero
    title={page.title}
    lead={page.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <Container class="py-20 md:py-28">
    <div class="grid gap-6 sm:grid-cols-2" data-reveal-group>
      {cards.map((card) => (
        <BusinessCard {...card} />
      ))}
    </div>
  </Container>
</BaseLayout>
