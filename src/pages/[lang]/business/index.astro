---
import BusinessSection from '../../../components/sections/BusinessSection.tsx';
import PageHero from '../../../components/sections/PageHero.tsx';
import { getLangPaths, getLocale, localizedPath, t } from '../../../i18n';
import { loadBusiness } from '../../../lib/sections/business';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const page = dict.business;
const section = await loadBusiness(lang);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: page.title, path: localizedPath(lang, '/business') },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} breadcrumbs={breadcrumbs}>
  <PageHero
    title={page.title}
    lead={page.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <BusinessSection {...section} />
</BaseLayout>
