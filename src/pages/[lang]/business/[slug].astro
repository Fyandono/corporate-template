---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageHero from '../../../components/sections/PageHero.tsx';
import PhotoFigure from '../../../components/ui/PhotoFigure.tsx';
import Section from '../../../components/ui/Section.astro';
import { site } from '../../../config/site';
import { getLocale, locales, localizedPath, t } from '../../../i18n';
import { loadBusinessDetail } from '../../../lib/sections/business';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Modul opsional: site.features.businessDetailPages
export async function getStaticPaths() {
  if (!site.features.businessDetailPages) return [];
  const entries = await getCollection('business');
  return locales.flatMap((lang) =>
    entries.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } })),
  );
}

type Props = { entry: CollectionEntry<'business'> };
const { entry } = Astro.props;
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const detail = await loadBusinessDetail(entry, lang);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: dict.business.title, path: localizedPath(lang, '/business') },
  { name: detail.title, path: localizedPath(lang, `/business/${entry.id}`) },
];
---

<BaseLayout lang={lang} title={detail.title} description={detail.summary} breadcrumbs={breadcrumbs}>
  <PageHero
    title={detail.title}
    lead={detail.summary}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <Section spacing="compact">
    <PhotoFigure image={detail.image} ratio="panorama" />
    <div class="mt-12 grid lg:grid-cols-12" data-reveal>
      <p class="text-lead text-neutral-600 lg:col-span-7 lg:col-start-6">{detail.description}</p>
    </div>
  </Section>
</BaseLayout>
