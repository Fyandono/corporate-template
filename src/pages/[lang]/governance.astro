---
import { site } from '../../config/site';
import MarkdownPageLayout from '../../layouts/MarkdownPageLayout.astro';
import { getLangPaths, getLocale } from '../../i18n';

// Modul opsional: aktifkan/nonaktifkan lewat site.features.governance
export const getStaticPaths = () => (site.features.governance ? getLangPaths() : []);
const lang = getLocale(Astro.params.lang);
---

<MarkdownPageLayout lang={lang} slug="governance" />
