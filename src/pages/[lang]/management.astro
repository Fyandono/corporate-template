---
import ManagementSection from '../../components/sections/ManagementSection.tsx';
import PageHero from '../../components/sections/PageHero.tsx';
import { getLangPaths, getLocale, localizedPath, t } from '../../i18n';
import { loadManagement } from '../../lib/sections/management';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const page = dict.management;
const section = await loadManagement(lang);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: page.title, path: localizedPath(lang, '/management') },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} breadcrumbs={breadcrumbs}>
  <PageHero
    title={page.title}
    lead={page.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <ManagementSection {...section} />
</BaseLayout>
