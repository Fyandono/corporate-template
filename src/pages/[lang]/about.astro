---
import AboutIntro from '../../components/sections/AboutIntro.tsx';
import PageHero from '../../components/sections/PageHero.tsx';
import Timeline from '../../components/sections/Timeline.tsx';
import ValuesGrid from '../../components/sections/ValuesGrid.tsx';
import VisionMission from '../../components/sections/VisionMission.tsx';
import { getLangPaths, getLocale, localizedPath, t } from '../../i18n';
import { loadAbout } from '../../lib/sections/about';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const page = dict.about;
const about = await loadAbout(lang);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: page.title, path: localizedPath(lang, '/about') },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} breadcrumbs={breadcrumbs}>
  <PageHero
    title={page.title}
    lead={page.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <AboutIntro id="profile" {...about.intro} />
  <VisionMission id="vision" {...about.visionMission} />
  <ValuesGrid id="values" {...about.values} />
  <Timeline id="history" {...about.timeline} />
</BaseLayout>
