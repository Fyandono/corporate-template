---
import { getCollection } from 'astro:content';
import PageHero from '../../components/sections/PageHero.tsx';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.tsx';
import { getLangPaths, getLocale, localize, localizedPath, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = () => getLangPaths();
const lang = getLocale(Astro.params.lang);
const dict = t(lang);
const about = dict.about;

const values = (await getCollection('values')).sort((a, b) => a.data.order - b.data.order);
const milestones = (await getCollection('milestones')).sort((a, b) => a.data.year - b.data.year);

const breadcrumbs = [
  { name: dict.nav.home, path: localizedPath(lang) },
  { name: about.title, path: localizedPath(lang, '/about') },
];
---

<BaseLayout
  lang={lang}
  title={about.title}
  description={about.description}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title={about.title}
    lead={about.lead}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />

  <section aria-labelledby="profile-title">
    <Container class="grid gap-10 py-20 md:py-28 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          id="profile-title"
          eyebrow={about.profileEyebrow}
          title={about.profileTitle}
        />
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-neutral-600 lg:col-span-7" data-reveal>
        {about.profileBody.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </Container>
  </section>

  <section aria-labelledby="vision-title" class="bg-primary-950 text-white">
    <Container class="grid gap-16 py-20 md:py-28 lg:grid-cols-2">
      <div data-reveal>
        <h2
          id="vision-title"
          class="text-accent-400 text-sm font-semibold tracking-[0.2em] uppercase"
        >
          {about.visionTitle}
        </h2>
        <p class="text-statement mt-6 font-medium text-white">{dict.home.statement}</p>
      </div>
      <div data-reveal>
        <h2 class="text-accent-400 text-sm font-semibold tracking-[0.2em] uppercase">
          {about.missionTitle}
        </h2>
        <ol class="mt-6 space-y-6">
          {about.mission.map((item, i) => (
            <li class="flex gap-5 border-t border-white/15 pt-6">
              <span class="text-accent-400 text-sm font-semibold" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-primary-100 text-lg leading-relaxed">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </Container>
  </section>

  <section aria-labelledby="values-title">
    <Container class="py-20 md:py-28">
      <SectionHeading id="values-title" eyebrow={about.valuesEyebrow} title={about.valuesTitle} />
      <ul
        class="mt-12 grid gap-px overflow-hidden rounded-card border border-neutral-200 bg-neutral-200 sm:grid-cols-2 lg:grid-cols-3"
        data-reveal-group
      >
        {values.map((v) => (
          <li class="bg-white p-8" data-reveal>
            <h3 class="text-xl">{localize(v.data.title, lang)}</h3>
            <p class="mt-3 leading-relaxed text-neutral-600">
              {localize(v.data.description, lang)}
            </p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section aria-labelledby="history-title" class="bg-neutral-50">
    <Container class="py-20 md:py-28">
      <SectionHeading
        id="history-title"
        eyebrow={about.historyEyebrow}
        title={about.historyTitle}
      />
      <ol class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {milestones.map((m) => (
          <li class="border-accent-500 relative border-t-2 pt-6" data-reveal>
            <p class="text-primary-900 text-4xl font-semibold tracking-tight">{m.data.year}</p>
            <h3 class="mt-4 text-lg">{localize(m.data.title, lang)}</h3>
            <p class="mt-2 leading-relaxed text-neutral-600">
              {localize(m.data.description, lang)}
            </p>
          </li>
        ))}
      </ol>
    </Container>
  </section>
</BaseLayout>
