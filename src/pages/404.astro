---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { localizedPath, t } from '../i18n';

// Firebase menyajikan halaman ini untuk semua URL yang tidak ditemukan. Ditampilkan dwibahasa.
const id = t('id').notFound;
const en = t('en').notFound;
---

<BaseLayout
  lang="id"
  title={`404 — ${id.title}`}
  description={id.body}
  alternates={{ id: localizedPath('id'), en: localizedPath('en') }}
>
  <section class="bg-primary-950 flex min-h-svh items-center text-white">
    <Container class="py-40">
      <p class="text-accent-400 text-sm font-semibold tracking-[0.25em]">404</p>
      <h1 class="text-display mt-6 text-white">{id.title}</h1>
      <p class="text-primary-100 mt-6 max-w-xl text-lg">{id.body}</p>
      <p class="text-primary-200 mt-2 max-w-xl" lang="en">
        {en.body}
      </p>
      <div class="mt-10 flex flex-wrap gap-4 text-sm font-semibold">
        <a href={localizedPath('id')} class="bg-accent-500 text-primary-950 rounded-card px-6 py-3">
          {id.back}
        </a>
        <a
          href={localizedPath('en')}
          lang="en"
          class="rounded-card border border-white/40 px-6 py-3 hover:bg-white/10"
        >
          {en.back}
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
